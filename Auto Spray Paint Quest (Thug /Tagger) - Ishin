-- State variables
local running = false
local loopEnabled = true
local currentStep = "พร้อมทำงาน"
local logs = {}
local completedInSession = 0

local function addLog(msg)
    local t = os.date("%H:%M:%S")
    table.insert(logs, 1, string.format("[%s] %s", t, msg))
    if #logs > 35 then table.remove(logs) end
end

local function unsitPlayer()
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum and hum.Sit then
        hum.Sit = false
        hum.Jump = true
        task.wait(0.2)
    end
end

local function equipSprayCan()
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if char:FindFirstChild("Spray Can") then return true end
    local bp = player:FindFirstChild("Backpack")
    local tool = bp and bp:FindFirstChild("Spray Can")
    if tool and hum then
        hum:EquipTool(tool)
        task.wait(0.25)
        return true
    end
    return false
end

-- หาผนังที่ NPC กำหนด (Indicator.Enabled == true)
local function getDesignatedWalls()
    local folder = getGraffitiFolder()
    if not folder then return {} end
    local list = {}
    for _, wall in ipairs(folder:GetChildren()) do
        local ind = wall:FindFirstChild("GraffitiIndicator")
        if ind and ind.Enabled then
            table.insert(list, wall)
        end
    end
    return list
end

-- คุยกับ NPC Thug
local function talkToThug()
    currentStep = "กำลังไปหา NPC Thug..."
    addLog("เดินทางไปหา NPC Thug")
    unsitPlayer()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local thug = getThug()
    if not root or not thug or not thug:FindFirstChild("HumanoidRootPart") then
        addLog("❌ ไม่พบ NPC Thug ในเซิร์ฟเวอร์")
        return false
    end

    -- หันหน้าเข้าหา Thug
    root.CFrame = thug.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3.2) * CFrame.Angles(0, math.rad(180), 0)

    -- หันกล้องไปที่ Thug เพื่อให้ปุ่ม [E] Talk ปรากฏแน่นอน
    local thugTarget = thug:FindFirstChild("Head") or thug.HumanoidRootPart
    local camConn = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if camera and root then
            local camPos = root.Position + Vector3.new(0, 1.8, 0) + (root.CFrame.LookVector * -2.5)
            camera.CFrame = CFrame.lookAt(camPos, thugTarget.Position)
        end
    end)

    task.wait(0.4)

    -- กดปุ่ม Talk
    local dialogue = getDialogue()
    local opened = dialogue and dialogue.Visible == true

    if not opened then
        local mui = getMuiPrompt()
        local btn = mui and mui:FindFirstChild("Button", true)
        local lbl = btn and btn:FindFirstChild("Label")

        for _ = 1, 15 do
            if dialogue and dialogue.Visible then
                opened = true
                break
            end
            if mui and mui.Enabled and btn and lbl and lbl.Text == "Talk" then
                for _, c in ipairs(getconnections(btn.Activated)) do
                    c.Function()
                end
                opened = true
                break
            end
            task.wait(0.15)
        end
    end

    camConn:Disconnect()

    if not opened then
        addLog("⚠️ ไม่สามารถกดคุยได้ กำลังลองใหม่...")
        return false
    end

    task.wait(0.4)

    -- ขั้นตอนที่ 1: หาตัวเลือกที่เขียนว่า "Give me the can."
    local dialogue = getDialogue()
    local bg = dialogue and dialogue:FindFirstChild("Background")

    for _ = 1, 20 do
        if dialogue and dialogue.Visible and bg then
            local foundOpt = nil
            for _, opt in ipairs(bg:GetChildren()) do
                if opt:IsA("ImageButton") and opt.Name:find("DialogueOption") and opt.Visible then
                    local optLbl = opt:FindFirstChild("DialogueLabel")
                    if optLbl and optLbl.Text:lower():find("give me") then
                        foundOpt = opt
                        break
                    end
                end
            end
            if foundOpt then
                for _, c in ipairs(getconnections(foundOpt.MouseButton1Click)) do
                    c.Function()
                end
                addLog("เลือก: Give me the can.")
                break
            end
        end
        task.wait(0.15)
    end

    task.wait(0.4)

    -- ขั้นตอนที่ 2: หาตัวเลือกที่เขียนว่า "Right." หรือกดยืนยันเริ่มเควส
    for _ = 1, 20 do
        if not dialogue or not dialogue.Visible then break end
        if bg then
            local foundOpt = nil
            for _, opt in ipairs(bg:GetChildren()) do
                if opt:IsA("ImageButton") and opt.Name:find("DialogueOption") and opt.Visible then
                    local optLbl = opt:FindFirstChild("DialogueLabel")
                    if optLbl and (optLbl.Text:lower():find("right") or optLbl.Text:lower():find("sure") or optLbl.Text:lower():find("okay")) then
                        foundOpt = opt
                        break
                    end
                end
            end
            if foundOpt then
                for _, c in ipairs(getconnections(foundOpt.MouseButton1Click)) do
                    c.Function()
                end
                addLog("เลือก: " .. (foundOpt:FindFirstChild("DialogueLabel") and foundOpt.DialogueLabel.Text or "ยืนยัน"))
                break
            end
        end
        task.wait(0.15)
    end

    task.wait(0.6)
    return true
end

-- พ่นผนัง 1 จุด
local function sprayWall(wall)
    if not wall then return false end
    unsitPlayer()
    equipSprayCan()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local decal = wall:FindFirstChild("Decal")
    local normal = decal and wall.CFrame:VectorToWorldSpace(Vector3.FromNormalId(decal.Face)) or wall.CFrame.LookVector

    local success = false
    -- ลองระยะ 2.8, 2.2, 3.4 studs
    for _, dist in ipairs({2.8, 2.2, 3.4}) do
        local standPos = wall.Position + (normal * dist)
        root.CFrame = CFrame.lookAt(Vector3.new(standPos.X, wall.Position.Y, standPos.Z), wall.Position)

        -- หันมุมกล้องมองตรงไปที่ผนัง เพื่อให้ไอคอน [E] ปรากฏขึ้นมาแน่นอน
        local camConn = RunService.RenderStepped:Connect(function()
            local camera = workspace.CurrentCamera
            if camera and root then
                local camPos = root.Position + Vector3.new(0, 1.8, 0) + (normal * 2.2)
                camera.CFrame = CFrame.lookAt(camPos, wall.Position)
            end
        end)

        task.wait(0.35)

        for _ = 1, 15 do
            local mui = getMuiPrompt()
            local btn = mui and mui:FindFirstChild("Button", true)
            local lbl = btn and btn:FindFirstChild("Label")
            if mui and mui.Enabled and btn and lbl and lbl.Text == "Spray" then
                for _, c in ipairs(getconnections(btn.Activated)) do
                    c.Function()
                end
                success = true
                break
            end
            task.wait(0.1)
        end

        camConn:Disconnect()
        if success then break end
    end

    if success then
        task.wait(0.8) -- รอเซิร์ฟเวอร์ตอบรับและเคลียร์สถานะผนัง
    end
    return success
end

-- วงจรทำงานหลักแบบสมบูรณ์ (ไม่มีการรอคูลดาวน์ ทำต่อเนื่องได้เรื่อยๆ)
local function mainWorkflow()
    if running then return end
    running = true

    while running do
        local hasCan = equipSprayCan()
        local designated = getDesignatedWalls()

        -- ถ้าไม่มีกระป๋องสเปรย์ หรือไม่มีผนังที่กำหนด -> ไปคุยกับ Thug ทันที ไม่รอคูลดาวน์
        if not hasCan or #designated == 0 then
            currentStep = "กำลังไปคุยรับเควสและสเปรย์จาก Thug..."
            local ok = talkToThug()
            if not ok then
                task.wait(1)
            else
                task.wait(0.5)
            end
            hasCan = equipSprayCan()
            designated = getDesignatedWalls()
        end

        if not running then break end

        -- ถ้ามีกระป๋องสเปรย์ และมีผนังที่กำหนด
        if #designated > 0 then
            addLog(string.format("เริ่มพ่นผนังที่กำหนด %d จุด", #designated))
            for idx, wall in ipairs(designated) do
                if not running then break end
                currentStep = string.format("กำลังพ่นจุดที่ %d/%d (%s)", idx, #designated, wall.Name)
                addLog(string.format("-> เดินทางไป %s", wall.Name))

                local sprayed = sprayWall(wall)
                if sprayed then
                    completedInSession = completedInSession + 1
                    addLog(string.format("✅ พ่นสำเร็จ: %s", wall.Name))
                else
                    addLog(string.format("⚠️ พ่นไม่สำเร็จ: %s", wall.Name))
                end
                task.wait(0.3)
            end
        end

        if not loopEnabled then
            addLog("เสร็จสิ้น 1 รอบ (ปิด Auto-Loop ไว้)")
            break
        end

        currentStep = "จบเควส กำลังไปรับเควสรอบต่อไป..."
        task.wait(0.5)
    end

    running = false
    currentStep = "หยุดการทำงาน"
    addLog("ระบบหยุดการทำงานแล้ว")
end

