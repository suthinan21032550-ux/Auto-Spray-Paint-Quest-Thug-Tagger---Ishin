end

local function getGraffitiFolder()
    return Workspace:FindFirstChild("GraffitiParts", true)
end

local function getMuiPrompt()
    return pgui:FindFirstChild("MultiOptionProximityPromptUI")
end

local function getDialogue()
    return pgui:FindFirstChild("NPCDialogue", true)
end

